<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Without this key, macOS does not show the microphone permission
         dialog at all — it silently denies access instead. This file is
         merged into the Tauri-generated Info.plist automatically. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>SpeechX needs microphone access to transcribe what you say into text.</string>

    <key>NSAccessibilityUsageDescription</key>
    <string>SpeechX needs Accessibility access to type transcribed text into other apps.</string>

    <key>NSInputMonitoringUsageDescription</key>
    <string>SpeechX needs Input Monitoring access to detect the Right Command and Right Option keys globally.</string>

    <key>LSRequiresCarbon</key>
    <false/>

    <!-- Without this, macOS's window-restoration ("Resume") feature
         tracks SpeechX's window state across launches, and if the
         process ever ends without going through a clean AppKit shutdown
         (a force-quit, `kill`, or `app.exit()`'s abrupt process exit
         rather than `NSApp.terminate:`'s normal teardown — all of which
         happen routinely for a background utility like this one), the
         next launch shows "SpeechX quit unexpectedly while reopening
         windows — Reopen / Don't Reopen". SpeechX has no session state
         worth restoring (just the dashboard, which reopens on demand via
         the tray icon anyway), so it opts out of the feature entirely
         rather than trying to make every possible exit path "clean". -->
    <key>NSQuitAlwaysKeepsWindows</key>
    <false/>
</dict>
</plist>
