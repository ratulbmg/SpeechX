{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpeechX",
  "version": "1.4.3",
  "identifier": "com.speechx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpeechX",
        "width": 420,
        "height": 520,
        "resizable": false,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../models/sherpa-onnx-whisper-base/": "models/sherpa-onnx-whisper-base/",
      "../models/sherpa-onnx-streaming-zipformer-bn-vosk-2026-02-09/": "models/sherpa-onnx-streaming-zipformer-bn-vosk-2026-02-09/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"],
        "installMode": "perMachine"
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
